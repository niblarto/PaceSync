<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose supplies the real theme (ui/theme) — this is just the
         pre-Compose window background so there's no white flash on launch. -->
    <style name="Theme.PaceSync" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>
